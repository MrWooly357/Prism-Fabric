{
  "schemaVersion": 1,
  "id": "prism",
  "version": "${version}",
  "name": "Prism",
  "description": "A lightweight rendering library/engine.",
  "authors": [
    "MrWooly357"
  ],
  "contact": {
    "sources": ""
  },
  "license": "MPL-2.0",
  "icon": "assets/prism/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      {
        "value": "net.mrwooly357.prism.client.Prism",
        "adapter": "kotlin"
      }
    ],
    "fabric-datagen": [
      {
        "value": "net.mrwooly357.prism.client.PrismDataGenerator",
        "adapter": "kotlin"
      }
    ]
  },
  "mixins": [
    {
      "config": "prism.client.mixins.json",
      "environment": "client"
    }
  ],
  "accessWidener": "prism.classtweaker",
  "depends": {
    "java": ">=25",
    "minecraft": "~26.2",
    "fabricloader": ">=0.19.3",
    "fabric-api": "*",
    "fabric-language-kotlin": "*"
  }
}